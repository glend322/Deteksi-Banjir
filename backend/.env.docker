# ─────────────────────────────────────────────────────────────────
# SafeRoute Semarang — Docker Environment
# Copy ke .env saat deploy, atau gunakan langsung:
#   docker-compose --env-file .env.docker up -d --build
# ─────────────────────────────────────────────────────────────────

# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=saferoute_db

# JWT — GANTI dengan nilai acak sebelum production!
# Generate: openssl rand -hex 32
SECRET_KEY=saferoute-semarang-super-secret-jwt-key-2026-hackathon
INTERNAL_API_KEY=internal-saferoute-ai-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CCTV Worker Settings
CCTV_SCAN_INTERVAL=60
CCTV_CONFIDENCE_THRESHOLD=0.5
CCTV_COOLDOWN_MINUTES=15

# OSRM (bisa diganti dengan instance lokal)
OSRM_BASE_URL=http://router.project-osrm.org
