PROJECT_NAME="SafeRoute API"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-32-character-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# PostgreSQL PostGIS Connection String
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/saferoute_db"

# OSRM Routing Engine
OSRM_BASE_URL="http://router.project-osrm.org"
ROUTING_TIMEOUT_SECONDS=4.0

# AI / ML Modeling Service
MODELING_API_URL="http://localhost:8001"
INTERNAL_API_KEY="replace-with-internal-api-key"

# CORS Origins (JSON list format)
BACKEND_CORS_ORIGINS=["http://localhost", "http://127.0.0.1:5500", "http://localhost:3000"]

