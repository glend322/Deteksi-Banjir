  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Path konfigurasi\n",
    "RAW_DIR = '../data/raw/rainfall'\n",
    "PROC_DIR = '../data/processed'\n",
    "\n",
    "# Load semua dataset\n",
    "df_rainfall = pd.read_csv(f'{RAW_DIR}/semarang_rainfall_historical.csv')\n",
    "df_daily = pd.read_csv(f'{PROC_DIR}/daily_features.csv')\n",
    "df_flood = pd.read_csv(f'{PROC_DIR}/flood_targets.csv')\n",
    "df_geo = pd.read_csv(f'{PROC_DIR}/geo_features.csv')\n",
    "df_elev = pd.read_csv(f'{PROC_DIR}/area_elevations.csv')\n",
    "\n",
    "print('Semua dataset berhasil dimuat!')"
   ]
  },
