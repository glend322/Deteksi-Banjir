   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Distribusi Curah Hujan per Area"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Hitung total precipitasi per area\n",
    "precip_cols = [c for c in df_rainfall.columns if c not in ['date', 'year', 'month', 'day']]\n",
    "if precip_cols:\n",
    "    area_precip = df_rainfall[precip_cols].sum().sort_values(ascending=False)\n",
    "else:\n",
    "    area_precip = df_rainfall.select_dtypes('number').sum().sort_values(ascending=False)\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "area_precip.plot(kind='bar', color=sns.color_palette('Blues_d', len(area_precip)))\n",
    "plt.title('Total Curah Hujan Tahunan per Area', fontsize=16, fontweight='bold')\n",
    "plt.xlabel('Area')\n",
    "plt.ylabel('Total Presipitasi (mm)')\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Histogram Elevasi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cari kolom elevasi\n",
    "elev_col = [c for c in df_elev.columns if 'elev' in c.lower() or 'height' in c.lower() or 'tinggi' in c.lower()]\n",
    "if not elev_col:\n",
    "    elev_col = df_elev.select_dtypes('number').columns.tolist()\n",
    "\n",
    "if elev_col:\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    sns.histplot(data=df_elev, x=elev_col[0], kde=True, color='teal', bins=30)\n",
    "    plt.title('Distribusi Elevasi Area', fontsize=16, fontweight='bold')\n",
    "    plt.xlabel('Elevasi (m)')\n",
    "    plt.ylabel('Frekuensi')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print('Kolom elevasi tidak ditemukan')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Distribusi Kelas Target Banjir"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cari kolom target\n",
    "target_col = [c for c in df_flood.columns if 'flood' in c.lower() or 'risk' in c.lower() or 'target' in c.lower() or 'label' in c.lower()]\n",
    "if not target_col:\n",
    "    target_col = [df_flood.columns[-1]]\n",
    "\n",
    "target_col = target_col[0]\n",
    "class_counts = df_flood[target_col].value_counts()\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "colors = ['#2ecc71', '#e74c3c'] if len(class_counts) == 2 else sns.color_palette('Set2', len(class_counts))\n",
    "class_counts.plot(kind='bar', color=colors)\n",
    "plt.title('Distribusi Kelas Target Banjir', fontsize=16, fontweight='bold')\n",
    "plt.xlabel('Flood Risk Label')\n",
    "plt.ylabel('Jumlah')\n",
    "plt.xticks(rotation=0)\n",
    "\n",
    "for i, v in enumerate(class_counts):\n",
    "    plt.text(i, v + 10, f'{v} ({v/len(df_flood)*100:.1f}%)', ha='center', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print(f'\\nClass distribution:\\n{class_counts}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Time Series Curah Hujan - 3 Area Teratas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ambil 3 area dengan curah hujan tertinggi\n",
    "top3_areas = area_precip.head(3).index.tolist()\n",
    "\n",
    "plt.figure(figsize=(14, 7))\n",
    "for area in top3_areas:\n",
    "    if area in df_rainfall.columns:\n",
    "        # Agregasi per bulan untuk visualisasi lebih jelas\n",
    "        if 'date' in df_rainfall.columns:\n",
    "            temp = df_rainfall[['date', area]].copy()\n",
    "            temp['date'] = pd.to_datetime(temp['date'])\n",
    "            temp = temp.set_index('date').resample('M')[area].sum()\n",
    "            plt.plot(temp.index, temp.values, label=area, linewidth=1.5)\n",
    "\n",
    "plt.title('Time Series Curah Hujan - 3 Area Teratas', fontsize=16, fontweight='bold')\n",
    "plt.xlabel('Tanggal')\n",
    "plt.ylabel('Total Presipitasi Bulanan (mm)')\n",
    "plt.legend(loc='upper right')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Heatmap Korelasi Fitur Numerik"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pilih hanya kolom numerik\n",
    "numeric_df = df_daily.select_dtypes(include='number')\n",
    "\n",
    "# Batasi jumlah kolom jika terlalu banyak\n",
    "if numeric_df.shape[1] > 15:\n",
    "    numeric_df = numeric_df.iloc[:, :15]\n",
    "    print(f'Menampilkan 15 kolom pertama dari {df_daily.select_dtypes(include=\"number\").shape[1]} kolom numerik')\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "corr = numeric_df.corr()\n",
    "mask = sns.triu(np.ones_like(corr, dtype=bool)) if len(numeric_df.columns) > 10 else None\n",
    "\n",
    "sns.heatmap(corr, \n",
    "            mask=mask,\n",
    "            annot=True if len(numeric_df.columns) <= 12 else False,\n",
    "            fmt='.2f',\n",
    "            cmap='RdBu_r',\n",
    "            center=0,\n",
    "            square=True,\n",
    "            linewidths=0.5,\n",
    "            cbar_kws={'shrink': 0.8})\n",
    "\n",
    "plt.title('Heatmap Korelasi Fitur Numerik', fontsize=16, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
