# SafeRoute Modeling - Environment Variables
# Copy this file to .env and fill in values

# BMKG API (optional)
BMKG_API_KEY=

# Backend URL (for sending detection results)
BACKEND_URL=http://localhost:8000

# Model checkpoint path
CV_CHECKPOINT=checkpoints/best.pt

# CCTV scan settings
CCTV_SCAN_INTERVAL=60
CCTV_CONFIDENCE_THRESHOLD=0.5
CCTV_COOLDOWN_MINUTES=15
